<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>校园活动报名与签到</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head>
<body class="bg-light"><main class="container py-4"><header class="d-flex justify-content-between align-items-center mb-4"><h1 class="h3">校园活动报名与签到</h1><div id="who"></div></header>
<div id="notice" class="alert alert-info d-none"></div><section id="loginBox" class="card p-4 mb-4"><h2 class="h5">登录</h2><form id="loginForm" class="row g-2"><div class="col-md-4"><input name="account" class="form-control" placeholder="账号" required></div><div class="col-md-4"><input name="password" type="password" class="form-control" placeholder="密码" required></div><div class="col"><button class="btn btn-primary">登录</button></div></form></section>
<section id="student" class="d-none"><h2 class="h5">已发布活动</h2><form id="search" class="d-flex gap-2 mb-3"><input name="q" class="form-control" placeholder="搜索活动"><select name="category" class="form-select" aria-label="活动类别"><option value="">全部类别</option></select><button class="btn btn-outline-primary">搜索</button></form><div id="activityList" class="row g-3"></div><div class="d-flex align-items-center gap-2 mt-3"><button id="prevPage" class="btn btn-sm btn-outline-secondary" type="button">上一页</button><span id="pageNumber"></span><button id="nextPage" class="btn btn-sm btn-outline-secondary" type="button">下一页</button></div><h2 class="h5 mt-4">我的活动</h2><div id="myList"></div></section>
<section id="owner" class="d-none"><h2 class="h5">创建活动</h2><form id="createForm" class="card card-body row g-2 mb-4"><input name="title" class="form-control" placeholder="名称" required><input name="category" class="form-control" placeholder="类别" required><input name="location" class="form-control" placeholder="地点" required><textarea name="description" class="form-control" placeholder="说明"></textarea><label>名额<input name="capacity" type="number" min="1" class="form-control" required></label><label>报名截止<input name="signupDeadline" type="datetime-local" class="form-control" required></label><label>开始<input name="startAt" type="datetime-local" class="form-control" required></label><label>结束<input name="endAt" type="datetime-local" class="form-control" required></label><button class="btn btn-primary">保存草稿</button></form><form id="editForm" class="card card-body row g-2 mb-4 d-none"><h2 class="h5">编辑活动</h2><input name="title" class="form-control" placeholder="名称" required><input name="category" class="form-control" placeholder="类别" required><input name="location" class="form-control" placeholder="地点" required><textarea name="description" class="form-control" placeholder="说明"></textarea><label>名额<input name="capacity" type="number" min="1" class="form-control" required></label><label>报名截止<input name="signupDeadline" type="datetime-local" class="form-control" required></label><label>开始<input name="startAt" type="datetime-local" class="form-control" required></label><label>结束<input name="endAt" type="datetime-local" class="form-control" required></label><div class="d-flex gap-2"><button class="btn btn-primary">保存修改</button><button type="button" class="btn btn-outline-secondary" onclick="$('#editForm').classList.add('d-none')">取消</button></div></form><h2 class="h5">我的活动</h2><div id="ownedList"></div></section>
<section id="admin" class="d-none"><h2 class="h5">待审核活动</h2><div id="pendingList"></div></section></main>
<script>
const base='<%= request.getContextPath() %>'; let csrf='',me=null;
const $=s=>document.querySelector(s); const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function notice(message){const n=$('#notice');n.textContent=message;n.classList.remove('d-none')}
async function api(path,body){const opt=body===undefined?{}:{method:'POST',body:body instanceof FormData?body:new URLSearchParams(body),headers:{'X-CSRF-Token':csrf}};const r=await fetch(base+path,opt);const t=await r.text();let data;try{data=JSON.parse(t)}catch{data=t}if(!r.ok)throw Error(data?.error||('请求失败：'+r.status));return data}
async function action(path,body={}){try{const result=await api(path,body);notice(result?.code?'签到码：'+result.code:'操作成功');await refresh()}catch(e){notice(e.message)}}
async function refresh(){try{me=await api('/me');csrf=me.csrf;$('#who').innerHTML=esc(me.name)+' <button class="btn btn-sm btn-outline-secondary" id="logout">退出</button>';$('#logout').onclick=()=>action('/logout');$('#loginBox').classList.add('d-none');for(const role of ['student','owner','admin'])$('#'+role).classList.toggle('d-none',me.role!==role.toUpperCase());if(me.role==='STUDENT')await student();if(me.role==='OWNER')await owner();if(me.role==='ADMIN')await admin()}catch{$('#loginBox').classList.remove('d-none');$('#who').textContent='';for(const role of ['student','owner','admin'])$('#'+role).classList.add('d-none')}}
let activityPage=1;
async function student(){const params=new URLSearchParams(new FormData($('#search')));params.set('page',activityPage);const list=await api('/activities?'+params);$('#activityList').innerHTML=list.length?list.map(a=>`<div class="col-md-6"><article class="card card-body h-100"><h3 class="h6">${esc(a.title)}</h3><p>${esc(a.category)} · ${esc(a.location)}<br>开始：${esc(a.start_at)}<br>剩余：${a.capacity-a.enrolled_count}</p><div class="d-flex gap-2 flex-wrap"><button class="btn btn-sm btn-primary" onclick="action('/activities/${a.id}/register')">报名</button><button class="btn btn-sm btn-outline-secondary" onclick="action('/activities/${a.id}/cancel-registration')">取消</button><button class="btn btn-sm btn-success" onclick="sign(${a.id})">签到</button></div></article></div>`).join(''):'<p>没有符合条件的活动</p>';$('#pageNumber').textContent='第 '+activityPage+' 页';$('#prevPage').disabled=activityPage===1;$('#nextPage').disabled=list.length<20;const mine=await api('/my/activities');$('#myList').innerHTML=mine.map(a=>`<div class="card card-body mb-2">${esc(a.title)} · ${esc(a.registration_status)} · ${a.signed_at?'已签到':'未签到'}</div>`).join('')}
async function loadCategories(){const select=$('#search').elements.category;const value=select.value;const categories=await api('/activities/categories');select.innerHTML='<option value="">全部类别</option>'+categories.map(c=>`<option value="${esc(c)}">${esc(c)}</option>`).join('');select.value=value}
function sign(id){const code=prompt('请输入 6 位签到码');if(code!==null)action('/activities/'+id+'/checkin',{code})}
let owned=[];
async function owner(){owned=await api('/owner/activities');$('#ownedList').innerHTML=owned.map(a=>`<article class="card card-body mb-2"><strong>${esc(a.title)}</strong><span>状态：${esc(a.status)} · 报名 ${a.enrolled_count}/${a.capacity}</span><div class="d-flex gap-2 flex-wrap mt-2">${['DRAFT','REJECTED'].includes(a.status)?`<button class="btn btn-sm btn-outline-primary" onclick="editActivity(${a.id})">编辑</button><button class="btn btn-sm btn-primary" onclick="action('/owner/activities/${a.id}/submit')">提交审核</button>`:''}${a.status==='PUBLISHED'?`<button class="btn btn-sm btn-success" onclick="action('/owner/activities/${a.id}/checkin/open')">开启签到</button><button class="btn btn-sm btn-secondary" onclick="action('/owner/activities/${a.id}/checkin/close')">关闭签到</button><button class="btn btn-sm btn-outline-primary" onclick="stats(${a.id})">统计</button>`:''}</div><pre id="stats${a.id}" class="mt-2"></pre></article>`).join('')}
function editActivity(id){const a=owned.find(item=>item.id===id);if(!a)return;const form=$('#editForm');form.dataset.id=id;for(const name of ['title','category','location','description','capacity'])form.elements[name].value=a[name]??'';for(const [name,key] of [['signupDeadline','signup_deadline'],['startAt','start_at'],['endAt','end_at']]){const value=a[key];const local=typeof value==='number'?new Date(value-new Date(value).getTimezoneOffset()*60000).toISOString().slice(0,16):String(value).replace(' ','T').slice(0,16);form.elements[name].value=local}form.classList.remove('d-none');form.scrollIntoView({behavior:'smooth'})}
async function stats(id){try{const s=await api('/owner/activities/'+id+'/attendance');$('#stats'+id).textContent=`报名 ${s.registered}，已签 ${s.signed}，未签 ${s.absent}，出勤率 ${s.rate.toFixed(1)}%\n`+s.roster.map(r=>r.display_name+'：'+(r.signed_at?'已签':'未签')).join('\n')}catch(e){notice(e.message)}}
async function admin(){const list=await api('/admin/activities');$('#pendingList').innerHTML=list.map(a=>`<article class="card card-body mb-2"><strong>${esc(a.title)}</strong><p>${esc(a.location)} · ${esc(a.start_at)}</p><div class="d-flex gap-2"><button class="btn btn-sm btn-success" onclick="action('/admin/activities/${a.id}/reviews',{approve:true})">通过</button><button class="btn btn-sm btn-danger" onclick="reject(${a.id})">驳回</button></div></article>`).join('')}
function reject(id){const remark=prompt('请输入驳回原因');if(remark)action('/admin/activities/'+id+'/reviews',{approve:false,remark})}
$('#loginForm').onsubmit=async e=>{e.preventDefault();try{me=await api('/login',new FormData(e.target));csrf=me.csrf;await refresh()}catch(err){notice(err.message)}};
$('#createForm').onsubmit=async e=>{e.preventDefault();await action('/owner/activities',new FormData(e.target))};$('#editForm').onsubmit=async e=>{e.preventDefault();try{await api('/owner/activities/'+e.target.dataset.id+'/edit',new FormData(e.target));e.target.classList.add('d-none');notice('修改已保存');await refresh()}catch(err){notice(err.message)}};$('#search').onsubmit=e=>{e.preventDefault();activityPage=1;student()};$('#prevPage').onclick=()=>{activityPage--;student()};$('#nextPage').onclick=()=>{activityPage++;student()};loadCategories().catch(e=>notice(e.message));refresh();
</script></body></html>
